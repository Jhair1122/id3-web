<?xml version="1.0" encoding="UTF-8"?>
<project ...>
    ...
    <repositories>
        <!-- Elimina el repositorio de Waikato para que no intente descargar -->
    </repositories>
    <dependencies>
        <!-- Otras dependencias de Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!-- No declaramos la dependencia de Weka aquí, la instalaremos manualmente -->
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>install-weka</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <configuration>
                            <file>${project.basedir}/src/main/resources/lib/weka-3-8-0-monolithic.jar</file>
                            <groupId>nz.ac.waikato.cms.weka</groupId>
                            <artifactId>weka-monolithic</artifactId>
                            <version>3.8.0</version>
                            <packaging>jar</packaging>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
